    "risklayer": {
      "value": "4.8/10 · medium",
      "summary": "Morpho is a modular lending protocol with ~$6.5B TVL across 37+ EVM chains, built around immutable Morpho Blue core markets and curator-managed vaults. The lending logic itself has never been directly exploited and carries tier-1 audit coverage plus Certora formal verification, but governance is concentrated in a 5-of-9 multisig with no protocol-wide timelock, permissionless oracle selection has produced recurring market-level losses (~$480K in Oct 2024), and seven cross-chain deployments lack block-explorer verification. Overall risk is moderate (4.8/10).",
      "details": [
        {
          "name": "Dependency Risk",
          "value": "4.8/10",
          "description": "Permissionless oracle selection with Chainlink feeds lacking staleness checks, no fallback oracles, and a paused LayerZero MORPHO bridge with multisig-controlled setPeer."
        },
        {
          "name": "Governance Risk",
          "value": "4.8/10",
          "description": "5/9 Gnosis Safe execution with no protocol-wide timelock, off-chain Snapshot voting without on-chain enforcement, and multisig control over token upgrades and LayerZero bridge configuration."
        },
        {
          "name": "Tokenomics Risk",
          "value": "5.8/10",
          "description": "Fixed 1B supply with ~88% allocated to treasury, investors, and insiders; significant vesting unlocks through 2028, no fee-switch value capture, and discretionary DAO reward emissions."
        },
        {
          "name": "Audit Coverage Risk",
          "value": "3.0/10",
          "description": "Industry-leading multi-firm audit program with Certora formal verification on core contracts; residual gaps are unverified cross-chain bytecode, one risk-accepted Vault V2 finding, and off-chain SDK/frontend outside audit scope."
        },
        {
          "name": "Smart Contract Risk",
          "value": "4.8/10",
          "description": "Morpho Blue core is immutable and extensively audited, but seven cross-chain deployments lack block-explorer verification, the MORPHO token uses UUPS upgradeable proxies, and permissionless market creation creates oracle misconfiguration exposure."
        }
