# Host address for the app's published port. Use the Docker host gateway
# address when a reverse proxy in another container connects to port 8080.
DEFI_DNA_BIND_IP=127.0.0.1

# Base path for the built frontend; use / for a dedicated domain.
DEFI_DNA_BASE=/

# pigi.finance Data API key (https://pigi.finance/defi-api). Read by the data
# pipeline; without it the pigi feed is skipped as a collection failure.
PIGI_API_KEY=
