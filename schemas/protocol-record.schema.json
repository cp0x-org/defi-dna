{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cp0x-org/defi-dna/main/schemas/protocol-record.schema.json",
  "title": "defi-dna protocol record",
  "description": "Generated data/protocols/<id>.json: what every feed published about one protocol. Changes only when a feed's content does; measured quantities live in metrics.json. Each optional extra field has a defined shape and a dedicated frontend view.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "feeds"],
  "properties": {
    "protocolId": {
      "type": "string"
    },
    "feeds": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/feedData"
      }
    }
  },
  "definitions": {
    "feedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "since"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": ["value", "url"]
          }
        }
      ],
      "properties": {
        "status": {
          "enum": ["ok", "none", "error"]
        },
        "value": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/detail"
          }
        },
        "updatedAt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "extra": {
          "$ref": "#/definitions/extra"
        },
        "since": {
          "description": "Added by the runner: the run that last changed this cell. Unchanged content keeps its earlier time.",
          "type": "string"
        }
      }
    },
    "metricData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "fetchedAt"],
      "properties": {
        "value": {
          "type": ["number", "null"]
        },
        "updatedAt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "extra": {
          "$ref": "#/definitions/extra"
        },
        "fetchedAt": {
          "description": "When we read it. Refreshed on every run.",
          "type": "string"
        }
      }
    },
    "detail": {
      "description": "A named part of an assessment or a fact about the record, in the source's words.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "extra": {
      "description": "Structured data beyond the headline, in the shapes the protocol page renders. Unknown keys are invalid; a new shape needs a schema entry, a TypeScript type and a component.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "description": "Facts about the record in the source's own terms, as name/value pairs.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/detail"
          }
        },
        "reviews": {
          "description": "Reviews the source files separately under this row, one deployment each.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/review"
          }
        },
        "findings": {
          "description": "Findings the source reports, with its own severity and category.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/finding"
          }
        },
        "vaults": {
          "description": "Individually rated vaults, largest first.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/vault"
          }
        },
        "incidents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/incident"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tvlComponent"
          }
        },
        "bodies": {
          "description": "Who decides, as the governance contracts read report it: token votes, multisigs with their thresholds, single keys, holder vetoes.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/governanceBody"
          }
        },
        "text": {
          "description": "Optional source-supplied paragraphs for information that has no more specific shape.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governanceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "kind": {
          "enum": ["token-vote", "multisig", "eoa", "veto"]
        },
        "token": {
          "type": "string"
        },
        "threshold": {
          "type": "integer"
        },
        "signers": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "multisig" } } },
          "then": { "required": ["threshold", "signers"] }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "stage", "risks", "date", "url"],
      "properties": {
        "file": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": ["string", "null"]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "category", "description"],
      "properties": {
        "title": {
          "type": "string"
        },
        "severity": {
          "type": ["string", "null"]
        },
        "category": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "curator", "tier", "score", "tvlUsd", "scoredAt", "url"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": ["string", "null"]
        },
        "curator": {
          "type": ["string", "null"]
        },
        "tier": {
          "type": ["string", "null"]
        },
        "score": {
          "type": ["number", "null"]
        },
        "tvlUsd": {
          "type": ["number", "null"]
        },
        "scoredAt": {
          "type": ["string", "null"]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "name",
        "amountUsd",
        "classification",
        "technique",
        "returnedFunds",
        "source"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "amountUsd": {
          "type": ["number", "null"]
        },
        "classification": {
          "type": "string"
        },
        "technique": {
          "type": "string"
        },
        "returnedFunds": {
          "type": ["number", "null"]
        },
        "source": {
          "type": ["string", "null"]
        }
      }
    },
    "tvlComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tvl"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tvl": {
          "type": ["number", "null"]
        }
      }
    }
  }
}
